//@version=6
indicator('Kim Bollinger Buy/Sell Bands', overlay = true)

// Inputs
length = input.int(20, 'Length')
mult = input.float(2.0, 'Std Dev', step = 0.1)

// ===== BUY BAND =====
// High EMA Bollinger
basisHighEMA = ta.ema(high, length)
devHighEMA = ta.stdev(high, length) * mult
upperHighEMA = basisHighEMA + devHighEMA
lowerHighEMA = basisHighEMA - devHighEMA

// High WMA Bollinger
basisHighWMA = ta.wma(high, length)
devHighWMA = ta.stdev(high, length) * mult
upperHighWMA = basisHighWMA + devHighWMA
lowerHighWMA = basisHighWMA - devHighWMA

// ===== SELL BAND =====
// Low EMA Bollinger
basisLowEMA = ta.ema(low, length)
devLowEMA = ta.stdev(low, length) * mult
upperLowEMA = basisLowEMA + devLowEMA
lowerLowEMA = basisLowEMA - devLowEMA

// Low WMA Bollinger
basisLowWMA = ta.wma(low, length)
devLowWMA = ta.stdev(low, length) * mult
upperLowWMA = basisLowWMA + devLowWMA
lowerLowWMA = basisLowWMA - devLowWMA

// ===== BUY ZONE (GREEN) =====
buyBand1 = plot(lowerHighEMA, color = color.new(color.green, 0), linewidth = 1)
buyBand2 = plot(lowerHighWMA, color = color.new(color.green, 0), linewidth = 1)

fill(buyBand1, buyBand2, color = color.new(color.green, 75))

// ===== SELL ZONE (RED) =====
sellBand1 = plot(upperLowEMA, color = color.new(color.red, 0), linewidth = 1)
sellBand2 = plot(upperLowWMA, color = color.new(color.red, 0), linewidth = 1)

fill(sellBand1, sellBand2, color = color.new(color.red, 75))

// ===== TREND MA =====
ma20 = ta.sma(close, 20)

maColor = ma20 > ma20[1] ? color.green : color.red

plot(ma20, title = '20 MA', color = maColor, linewidth = 2)

// =========================
// MTF TREND TABLE
// =========================

// Get 20 SMA from higher timeframes
h1_ma     = request.security(syminfo.tickerid, "60", ta.sma(close, 20))
h1_ma_prev= request.security(syminfo.tickerid, "60", ta.sma(close, 20)[1])

h4_ma     = request.security(syminfo.tickerid, "240", ta.sma(close, 20))
h4_ma_prev= request.security(syminfo.tickerid, "240", ta.sma(close, 20)[1])

d_ma      = request.security(syminfo.tickerid, "D", ta.sma(close, 20))
d_ma_prev = request.security(syminfo.tickerid, "D", ta.sma(close, 20)[1])

// Trend Logic
h1Trend = h1_ma > h1_ma_prev ? "UP" : "DOWN"
h4Trend = h4_ma > h4_ma_prev ? "UP" : "DOWN"
dTrend  = d_ma > d_ma_prev ? "UP" : "DOWN"

// Colors
h1Color = h1Trend == "UP" ? color.lime : color.red
h4Color = h4Trend == "UP" ? color.lime : color.red
dColor  = dTrend  == "UP" ? color.lime : color.red

// Create Table
var table trendTable = table.new(
     position.top_right,
     2,
     4,
     border_width=1)

// Update table on last bar only
if barstate.islast
    table.cell(trendTable, 0, 0, "TIMEFRAME", bgcolor=color.black, text_color=color.white)
    table.cell(trendTable, 1, 0, "TREND", bgcolor=color.black, text_color=color.white)

    table.cell(trendTable, 0, 1, "1H")
    table.cell(trendTable, 1, 1, h1Trend, bgcolor=h1Color, text_color=color.white)

    table.cell(trendTable, 0, 2, "4H")
    table.cell(trendTable, 1, 2, h4Trend, bgcolor=h4Color, text_color=color.white)

    table.cell(trendTable, 0, 3, "DAILY")
    table.cell(trendTable, 1, 3, dTrend, bgcolor=dColor, text_color=color.white)