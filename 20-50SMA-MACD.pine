//@version=6
indicator('20/200 SMA Cross + MACD', overlay=true)

// ═══════════════════════════════════════════════════════════
// COLOR CONSTANTS
// ═══════════════════════════════════════════════════════════
const color LONG_C       = #22c55e   // bullish / up-trend
const color SHORT_C      = #ef4444   // bearish / down-trend
const color NEUTRAL_C    = color.gray
const color FAST_SMA_C   = #00ff00   // 20 SMA (light green)
const color SLOW_SMA_C   = #ffea00   // 200 SMA (thistle)
const color TABLE_BG_C   = #0f172a   // info table background
const color TABLE_TEXT_C = color.gray // info table labels

// ═══════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════

// ── Moving Averages ─────────────────────────────────────────
sma_fast_len = input.int(20,  'Fast SMA Length',  minval=1, group='Moving Averages')
sma_slow_len = input.int(200, 'Slow SMA Length',  minval=1, group='Moving Averages')

// ── MACD ────────────────────────────────────────────────────
float  sourceInput  = input.source(close, 'Source', group='MACD')
int    fastLenInput = input.int(12, 'Fast length',   1, group='MACD')
int    slowLenInput = input.int(26, 'Slow length',   1, group='MACD')
int    sigLenInput  = input.int(9,  'Signal length', 1, group='MACD')
string oscTypeInput = input.string('EMA', 'Oscillator MA type', ['EMA', 'SMA'], group='MACD')
string sigTypeInput = input.string('EMA', 'Signal MA type',     ['EMA', 'SMA'], group='MACD')

// ── Display ──────────────────────────────────────────────────
show_fast_sma = input.bool(true, 'Show 20 SMA', group='Display')
show_slow_sma = input.bool(true, 'Show 200 SMA', group='Display')
show_bg       = input.bool(true, 'Trend Background', group='Display')
show_arrows   = input.bool(true, 'Signal Arrows',    group='Display')
show_table    = input.bool(true, 'Info Table',       group='Display')

// ═══════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════

sma20  = ta.sma(close, sma_fast_len)
sma200 = ta.sma(close, sma_slow_len)

// @function    Calculates an EMA or SMA of a `source` series.
ma(float source, int length, simple string maType) =>
    switch maType
        'EMA' => ta.ema(source, length)
        'SMA' => ta.sma(source, length)

// MACD
float maFast = ma(sourceInput, fastLenInput, oscTypeInput)
float maSlow = ma(sourceInput, slowLenInput, oscTypeInput)
float macd   = maFast - maSlow
float signal = ma(macd, sigLenInput, sigTypeInput)
float hist   = macd - signal

trend_up   = macd >= 0
trend_down = macd < 0

// Setup: SMA alignment + MACD line and signal both in the correct half.
sma_bullish = sma20 > sma200
sma_bearish = sma20 < sma200

long_setup  = sma_bullish and macd > 0 and signal > 0
short_setup = sma_bearish and macd < 0 and signal < 0

// Signal: LONG — uptrend alignment, price squeezed between SMAs, MACD >= 5,
// and close not within ±7 of either SMA.
price_between_smas_long  = sma200 < close and close < sma20
away_from_sma20_long     = math.abs(close - sma20) > 7
away_from_sma200_long    = math.abs(close - sma200) > 7

// Signal: SHORT — downtrend alignment, price squeezed between SMAs, MACD <= -5,
// and close not within ±7 of either SMA.
price_between_smas_short = sma20 < close and close < sma200
away_from_sma20_short    = math.abs(close - sma20) > 7
away_from_sma200_short   = math.abs(close - sma200) > 7

long_cond  = sma_bullish and price_between_smas_long and macd >= 5 and away_from_sma20_long and away_from_sma200_long
short_cond = sma_bearish and price_between_smas_short and macd <= -5 and away_from_sma20_short and away_from_sma200_short

// ═══════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════

// Trend background — green in long setup, red in short setup.
bg_color = long_setup  ? color.new(LONG_C, 92)
         : short_setup ? color.new(SHORT_C, 92)
         : na
bgcolor(show_bg ? bg_color : na, title='Trend Background')

// Moving averages: clean, thin lines.
plot(show_fast_sma ? sma20 : na, title='20 SMA', color=color.new(FAST_SMA_C, 0), linewidth=1)
plot(show_slow_sma ? sma200 : na, title='200 SMA', color=color.new(SLOW_SMA_C, 0), linewidth=2)

// Minimal arrows: no text, small size.
plotshape(long_cond  and show_arrows, title='Long Signal',
     style=shape.triangleup, location=location.belowbar,
     color=color.new(LONG_C, 0), size=size.small, text='')

plotshape(short_cond and show_arrows, title='Short Signal',
     style=shape.triangledown, location=location.abovebar,
     color=color.new(SHORT_C, 0), size=size.small, text='')

// ═══════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════
// alertcondition fires whenever the signal is true, regardless of the
// 'Signal Arrows' display toggle — users can mute the arrows but still
// receive alerts.

alertcondition(long_cond,  title='SMA+MACD Long',  message='20/200 SMA Cross + MACD — LONG signal on {{ticker}} ({{interval}})')
alertcondition(short_cond, title='SMA+MACD Short', message='20/200 SMA Cross + MACD — SHORT signal on {{ticker}} ({{interval}})')
alertcondition(long_cond or short_cond, title='SMA+MACD Any', message='20/200 SMA Cross + MACD — signal on {{ticker}} ({{interval}})')

// Bar color from MACD direction.
barcolor(color=trend_up ? color.lime : trend_down ? color.red : color.gray)

// ═══════════════════════════════════════════════════════════
// INFO TABLE  (bottom-right)
// ═══════════════════════════════════════════════════════════

var table info = table.new(position.bottom_right, 2, 6,
     bgcolor     = color.new(TABLE_BG_C, 30),
     frame_width = 0)

sma20_above_sma200 = sma20 > sma200
sma20_below_sma200 = sma20 < sma200

close_vs_sma20  = close - sma20
close_vs_sma200 = close - sma200

if barstate.islast and show_table
    table.cell(info, 0, 0, '20 SMA / 200 SMA', text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 0, sma20_above_sma200 ? 'BULL' : 'BEAR',
               text_color=sma20_above_sma200 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 1, 'MACD',              text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 1, trend_up ? 'UP' : trend_down ? 'DOWN' : '—',
               text_color=trend_up ? LONG_C : trend_down ? SHORT_C : NEUTRAL_C, text_size=size.normal)

    table.cell(info, 0, 2, 'MACD Value',        text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 2, str.tostring(macd, format.mintick),
               text_color=macd >= 0 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 3, 'Signal',            text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 3, long_cond ? 'LONG' : short_cond ? 'SHORT' : '—',
               text_color=long_cond ? LONG_C : short_cond ? SHORT_C : NEUTRAL_C, text_size=size.normal)

    table.cell(info, 0, 4, 'Close vs 20',       text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 4, str.tostring(close_vs_sma20, format.mintick),
               text_color=close_vs_sma20 >= 0 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 5, 'Close vs 200',      text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 5, str.tostring(close_vs_sma200, format.mintick),
               text_color=close_vs_sma200 >= 0 ? LONG_C : SHORT_C, text_size=size.normal)