//@version=6
indicator('20/200 SMA Cross + MACD', overlay=true)

// ═══════════════════════════════════════════════════════════
// COLOR CONSTANTS
// ═══════════════════════════════════════════════════════════
const color LONG_C       = #22c55e   // bullish / up-trend
const color SHORT_C      = #ef4444   // bearish / down-trend
const color NEUTRAL_C    = color.gray
const color FAST_SMA_C   = #00ff00   // 20 SMA (light green)
const color SLOW_SMA_C   = #ffea00   // 200 SMA (thistle)
const color TABLE_BG_C   = #0f172a   // info table background
const color TABLE_TEXT_C = color.gray // info table labels

// ═══════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════

// ── Moving Averages ─────────────────────────────────────────
sma_fast_len = input.int(20,  'Fast SMA Length',  minval=1, group='Moving Averages')
sma_slow_len = input.int(200, 'Slow SMA Length',  minval=1, group='Moving Averages')

// ── MACD ────────────────────────────────────────────────────
float  sourceInput  = input.source(close, 'Source', group='MACD')
int    fastLenInput = input.int(20, 'Fast length',   1, group='MACD')
int    slowLenInput = input.int(200, 'Slow length',   1, group='MACD')
int    sigLenInput  = input.int(9,  'Signal length', 1, group='MACD')
string oscTypeInput = input.string('EMA', 'Oscillator MA type', ['EMA', 'SMA'], group='MACD')
string sigTypeInput = input.string('EMA', 'Signal MA type',     ['EMA', 'SMA'], group='MACD')

// ── Display ──────────────────────────────────────────────────
show_fast_sma = input.bool(true, 'Show 20 SMA', group='Display')
show_slow_sma = input.bool(true, 'Show 200 SMA', group='Display')
show_bg       = input.bool(true, 'Trend Background', group='Display')
show_arrows   = input.bool(true, 'Signal Arrows',    group='Display')
show_barcolor = input.bool(true, 'Bar Color',        group='Display')
show_table    = input.bool(true, 'Info Table',       group='Display')

// ═══════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════

sma20  = ta.sma(close, sma_fast_len)
sma200 = ta.sma(close, sma_slow_len)

// @function    Calculates an EMA or SMA of a `source` series.
ma(float source, int length, simple string maType) =>
    switch maType
        'EMA' => ta.ema(source, length)
        'SMA' => ta.sma(source, length)

// MACD
float maFast = ma(sourceInput, fastLenInput, oscTypeInput)
float maSlow = ma(sourceInput, slowLenInput, oscTypeInput)
float macd   = maFast - maSlow
float signal = ma(macd, sigLenInput, sigTypeInput)

float hist = macd - signal

// ═══════════════════════════════════════════════════════════
// 3P ENTRY LOGIC
// ═══════════════════════════════════════════════════════════

// P1 — SMA trend alignment. Mismatch → skip entry.
p1_long  = sma20 > sma200
p1_short = sma20 < sma200

// P2 — MACD histogram filter. Else skip entry.
p2_long  = hist >= 2.0
p2_short = hist <= -2.0

// P3 — MACD histogram zero-line cross this candle.
//      LONG: macd_line > macd_signal > 0
//      SHORT: macd_line < macd_signal < 0
p3_long  = macd > 0
p3_short = macd < 0

long_setup  = p1_long and p2_long and p3_long
short_setup = p1_short and p2_short and p3_short

long_signal  = long_setup
short_signal = short_setup

// ═══════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════

// Trend background — green in long setup, red in short setup.
bg_color = long_setup  ? color.new(LONG_C, 92)
         : short_setup ? color.new(SHORT_C, 92)
         : na
bgcolor(show_bg ? bg_color : na, title='Trend Background')

// Bar coloring based on price vs 20/200 SMAs.
// Strong trend: price is on the same side of both SMAs as the SMA ordering.
bar_color = close > sma20 and sma20 > sma200 ? color.new(LONG_C, 0)
          : close < sma20 and sma20 < sma200 ? color.new(SHORT_C, 0)
          : color.new(NEUTRAL_C, 0)
barcolor(show_barcolor ? bar_color : na, title='SMA Bar Color')

// Moving averages: clean, thin lines.
plot(show_fast_sma ? sma20 : na, title='20 SMA', color=color.new(FAST_SMA_C, 0), linewidth=2)
plot(show_slow_sma ? sma200 : na, title='200 SMA', color=color.new(SLOW_SMA_C, 0), linewidth=3)

// Signal arrows with text labels on the triggering candle.
plotshape(long_signal  and show_arrows, title='Long Signal',
     style=shape.triangleup, location=location.belowbar,
     color=color.new(LONG_C, 0),
     text='L', textcolor=color.new(LONG_C, 0),
     size=size.tiny)

plotshape(short_signal and show_arrows, title='Short Signal',
     style=shape.triangledown, location=location.abovebar,
     color=color.new(SHORT_C, 0),
     text='S', textcolor=color.new(SHORT_C, 0),
     size=size.tiny)

// ═══════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════
// alertcondition fires whenever the signal is true, regardless of the
// 'Signal Arrows' display toggle — users can mute the arrows but still
// receive alerts.

alertcondition(long_signal,  title='SMA+MACD Long',  message='20/200 SMA Cross + MACD — LONG signal on {{ticker}} ({{interval}})')
alertcondition(short_signal, title='SMA+MACD Short', message='20/200 SMA Cross + MACD — SHORT signal on {{ticker}} ({{interval}})')
alertcondition(long_signal or short_signal, title='SMA+MACD Any', message='20/200 SMA Cross + MACD — signal on {{ticker}} ({{interval}})')

// ═══════════════════════════════════════════════════════════
// INFO TABLE  (bottom-right)
// ═══════════════════════════════════════════════════════════

var table info = table.new(position.bottom_right, 2, 6,
     bgcolor     = color.new(TABLE_BG_C, 30),
     frame_width = 0)

if barstate.islast and show_table
    table.cell(info, 0, 0, 'Signal',            text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 0, long_setup ? 'LONG' : short_setup ? 'SHORT' : '—',
               text_color=long_setup ? LONG_C : short_setup ? SHORT_C : NEUTRAL_C, text_size=size.normal)

    table.cell(info, 0, 1, 'Close',             text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 1, str.tostring(close, format.mintick),
               text_color=close >= sma200 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 2, '20 SMA',            text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 2, str.tostring(sma20, format.mintick),
               text_color=sma20 >= sma200 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 3, '200 SMA',           text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 3, str.tostring(sma200, format.mintick),
               text_color=sma20 >= sma200 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 4, 'MACD',              text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 4, str.tostring(macd, format.mintick),
               text_color=macd >= 0 ? LONG_C : SHORT_C, text_size=size.normal)

    table.cell(info, 0, 5, 'MACD Signal',       text_color=TABLE_TEXT_C, text_size=size.normal)
    table.cell(info, 1, 5, str.tostring(signal, format.mintick),
               text_color=signal >= 0 ? LONG_C : SHORT_C, text_size=size.normal)