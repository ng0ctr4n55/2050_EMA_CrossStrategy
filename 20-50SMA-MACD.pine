//@version=6
indicator('20/200 SMMA Cross + MACD', overlay=true)

// ═══════════════════════════════════════════════════════════
// COLOR CONSTANTS
// ═══════════════════════════════════════════════════════════
const color LONG_C       = #22c55e   // bullish / up-trend
const color SHORT_C      = #ef4444   // bearish / down-trend
const color NEUTRAL_C    = color.gray
const color FAST_SMMA_C  = #00ff00   // 20 SMMA (light green)
const color SLOW_SMMA_C  = #ffea00   // 200 SMMA (thistle)
const color TABLE_BG_C   = #0f172a   // info table background
const color TABLE_TEXT_C = color.gray // info table labels

// ═══════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════

// ── Moving Averages ─────────────────────────────────────────
smma_fast_len = input.int(20,  'Fast SMMA Length',  minval=1, group='Moving Averages')
smma_slow_len = input.int(200, 'Slow SMMA Length',  minval=1, group='Moving Averages')

// ── MACD ────────────────────────────────────────────────────
float  sourceInput  = input.source(close, 'Source', group='MACD')
int    fastLenInput = input.int(20, 'Fast length',   1, group='MACD')
int    slowLenInput = input.int(200, 'Slow length',   1, group='MACD')
int    sigLenInput  = input.int(9,  'Signal length', 1, group='MACD')
string oscTypeInput = input.string('EMA', 'Oscillator MA type', ['EMA', 'SMMA'], group='MACD')
string sigTypeInput = input.string('EMA', 'Signal MA type',     ['EMA', 'SMMA'], group='MACD')

// ── Display ──────────────────────────────────────────────────
show_fast_smma = input.bool(true, 'Show 20 SMMA', group='Display')
show_slow_smma = input.bool(true, 'Show 200 SMMA', group='Display')
show_bg       = input.bool(true, 'Trend Background', group='Display')
show_arrows   = input.bool(true, 'Signal Arrows',    group='Display')
show_barcolor = input.bool(true, 'Bar Color',        group='Display')
show_table    = input.bool(true, 'Info Table',       group='Display')

// ═══════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════

// Smoothed Moving Average (SMMA).
smma(float source, int length) =>
    float _smma = 0.0
    _smma := na(_smma[1]) ? ta.sma(source, length) : (_smma[1] * (length - 1) + source) / length
    _smma

smma20  = smma(close, smma_fast_len)
smma200 = smma(close, smma_slow_len)
smma_diff = smma20 - smma200

// @function    Calculates an EMA or SMMA of a `source` series.
ma(float source, int length, simple string maType) =>
    switch maType
        'EMA'  => ta.ema(source, length)
        'SMMA' => smma(source, length)

// MACD
float maFast = ma(sourceInput, fastLenInput, oscTypeInput)
float maSlow = ma(sourceInput, slowLenInput, oscTypeInput)
float macd   = maFast - maSlow
float signal = ma(macd, sigLenInput, sigTypeInput)
float macd_diff = macd - signal

float hist = macd - signal

// ═══════════════════════════════════════════════════════════
// 3P ENTRY LOGIC
// ═══════════════════════════════════════════════════════════

// P1 — SMMA trend alignment. Mismatch → skip entry.
p1_long  = close > smma20 and smma20 > smma200
p1_short = close < smma20 and smma20 < smma200

// P2 — MACD histogram filter. Else skip entry.
p2_long  = hist > 0
p2_short =  hist < 0

// P3 — MACD histogram zero-line cross this candle.
//      LONG: macd_line > macd_signal > 0
//      SHORT: macd_line < macd_signal < 0
p3_long  =  macd > signal and macd > 5
p3_short =  signal < signal and macd < 5

long_setup  = p1_long and p2_long and p3_long
short_setup = p1_short and p2_short and p3_short

long_signal  = long_setup
short_signal = short_setup

// ═══════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════

// Trend background — green in long setup, red in short setup.
bg_color = long_setup  ? color.new(LONG_C, 92)
         : short_setup ? color.new(SHORT_C, 92)
         : na
bgcolor(show_bg ? bg_color : na, title='Trend Background')

// Bar coloring based on price vs 20/200 SMMAs.
// Strong trend: price is on the same side of both SMMAs as the SMMA ordering.
bar_color = close > smma20 and smma20 > smma200 ? color.new(LONG_C, 0)
          : close < smma20 and smma20 < smma200 ? color.new(SHORT_C, 0)
          : color.new(NEUTRAL_C, 0)
barcolor(show_barcolor ? bar_color : na, title='SMMA Bar Color')

// Moving averages: clean, thin lines.
plot(show_fast_smma ? smma20 : na, title='20 SMMA', color=color.new(FAST_SMMA_C, 0), linewidth=2)
plot(show_slow_smma ? smma200 : na, title='200 SMMA', color=color.new(SLOW_SMMA_C, 0), linewidth=3)

// Signal arrows with text labels on the triggering candle.
plotshape(long_signal  and show_arrows, title='Long Signal',
     style=shape.triangleup, location=location.belowbar,
     color=color.new(LONG_C, 0),
     text='L', textcolor=color.new(LONG_C, 0),
     size=size.auto)

plotshape(short_signal and show_arrows, title='Short Signal',
     style=shape.triangledown, location=location.abovebar,
     color=color.new(SHORT_C, 0),
     text='S', textcolor=color.new(SHORT_C, 0),
     size=size.auto)

// ═══════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════
// alertcondition fires whenever the signal is true, regardless of the
// 'Signal Arrows' display toggle — users can mute the arrows but still
// receive alerts.

alertcondition(long_signal,  title='SMMA+MACD Long',  message='20/200 SMMA Cross + MACD — LONG signal on {{ticker}} ({{interval}})')
alertcondition(short_signal, title='SMMA+MACD Short', message='20/200 SMMA Cross + MACD — SHORT signal on {{ticker}} ({{interval}})')
alertcondition(long_signal or short_signal, title='SMMA+MACD Any', message='20/200 SMMA Cross + MACD — signal on {{ticker}} ({{interval}})')

// ═══════════════════════════════════════════════════════════
// INFO TABLE  (bottom-right)
// ═══════════════════════════════════════════════════════════

var table info = table.new(position.bottom_right, 2, 4,
     bgcolor     = color.new(TABLE_BG_C, 30),
     frame_width = 0)

if barstate.islast and show_table
    table.cell(info, 0, 0, 'Signal',            text_color=TABLE_TEXT_C, text_size=size.auto)
    table.cell(info, 1, 0, long_setup ? 'LONG' : short_setup ? 'SHORT' : '—',
               text_color=long_setup ? LONG_C : short_setup ? SHORT_C : NEUTRAL_C, text_size=size.auto)

    table.cell(info, 0, 1, 'Close',             text_color=TABLE_TEXT_C, text_size=size.auto)
    table.cell(info, 1, 1, str.tostring(close[1], format.mintick),
               text_color=close[1] >= smma200 ? LONG_C : SHORT_C, text_size=size.auto)

    table.cell(info, 0, 2, 'SMMA Diff',         text_color=TABLE_TEXT_C, text_size=size.auto)
    table.cell(info, 1, 2, str.tostring(smma_diff, format.mintick),
               text_color=hist >= 0 ? LONG_C : SHORT_C, text_size=size.auto)

    table.cell(info, 0, 3, 'MACD Diff',         text_color=TABLE_TEXT_C, text_size=size.auto)
    table.cell(info, 1, 3, str.tostring(macd_diff, format.mintick),
               text_color=hist >= 0 ? LONG_C : SHORT_C, text_size=size.auto)
